{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@packages/*": ["../../packages/*/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.mjs", "index.ts"],
  "exclude": ["node_modules", "dist"]
}
