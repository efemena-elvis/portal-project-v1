{
  "name": "merchant-federation",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx,vue}\"",
    "check-types": "turbo run check-types",
    "dev:staging:merchant-checkout": "turbo run dev --filter=merchant-checkout -- --mode=staging",
    "dev:prod:merchant-checkout": "turbo run dev --filter=merchant-checkout -- --mode=production",
    "build:staging:merchant-checkout": "turbo run build --filter=merchant-checkout -- --mode=staging",
    "build:prod:merchant-checkout": "turbo run build --filter=merchant-checkout -- --mode=production",
    "dev:staging:merchant-of-records": "turbo run dev --filter=merchant-of-records -- --mode=staging",
    "dev:prod:merchant-of-records": "turbo run dev --filter=merchant-of-records -- --mode=production",
    "build:staging:merchant-of-records": "turbo run build --filter=merchant-of-records -- --mode=staging",
    "build:prod:merchant-of-records": "turbo run build --filter=merchant-of-records -- --mode=production"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.19",
    "env-cmd": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^8.7.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "sass-loader": "^12.0.0",
    "tailwindcss": "^3.4.4",
    "turbo": "^2.4.4",
    "typescript": "5.8.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.21.0",
    "@cloudinary/vue": "^1.13.1",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.7.4",
    "chart.js": "^4.4.3",
    "cloudinary": "^2.6.1",
    "core-js": "^3.8.3",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1",
    "pinia": "^2.2.2",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.1",
    "vue-router": "^4.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
