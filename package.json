{
  "name": "portal-project-v1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:staging:backoffice": "turbo run build --filter=@portal-project-v1/backoffice -- --mode staging",
    "build:prod:backoffice": "turbo run build --filter=@portal-project-v1/backoffice -- --mode production",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx,vue}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9.8.1"
}
